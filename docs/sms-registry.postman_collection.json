              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"\",\n  \"email\": \"not-an-email\",\n  \"dateOfBirth\": \"2020-01-01\",\n  \"programmeId\": \"\",\n  \"academicYear\": \"2026/28\"\n}",
              "options": {
