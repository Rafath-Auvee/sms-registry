        {
          "name": "409: duplicate payment reference",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "role=staff",
                "description": "Which view is calling: staff, or a student by id"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
