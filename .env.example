# Copy to .env and fill in. Never commit .env.

# Option A: Neon (or any hosted Postgres). Neon > project > Connect.
# DATABASE_URL: pooled URL (host contains -pooler), used by the app.
# DIRECT_URL:   same URL without -pooler, used by Prisma migrations.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Option B: local Postgres or `npm run db:up` (Docker). DIRECT_URL not needed.
DATABASE_URL="postgresql://sms:sms@localhost:5432/sms_registry"
