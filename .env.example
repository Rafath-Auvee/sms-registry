# Copy to .env: cp .env.example .env

# Shared demo database (Neon, Singapore), already migrated and seeded, so the app runs as is.
# It's a throwaway assessment database; `npm run db:seed` resets it to the demo data at any time.
# DATABASE_URL: pooled URL, used by the app. DIRECT_URL: direct URL, used by Prisma migrations.
DATABASE_URL="postgresql://neondb_owner:npg_AosZ6gc9KUBL@ep-patient-moon-b3x2awbg-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
DIRECT_URL="postgresql://neondb_owner:npg_AosZ6gc9KUBL@ep-patient-moon-b3x2awbg.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

